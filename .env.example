# ==============================================================================
# YunTransfer Telegram Bot 环境变量配置模板 (.env.example)
# 复制为 .env 后填入真实参数：cp .env.example .env
# ==============================================================================

# --- 1. 自建 Local Telegram Bot API 必填凭证 (仅注入 telegram-bot-api 容器) ---
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
TELEGRAM_API_VERBOSITY=1
TELEGRAM_API_HOST_PORT=38081

# --- 2. Bot 核心身份与只读安全信任根 (仅环境变量只读，禁止 Web 修改) ---
TZ=Asia/Shanghai
TELEGRAM_BOT_TOKEN=123456789:AAExampleBotTokenPlaceholder012345678
TELEGRAM_ADMIN_ID=100000001
WEB_BIND_HOST=0.0.0.0
WEB_HOST_PORT=38082
WEB_BASE_URL=http://127.0.0.1:38082
WEB_TRUSTED_PROXIES=

# --- 3. 初始访问控制名单 (首次启动无记录时导入一次) ---
WHITELIST_ENABLED=true
INITIAL_WHITELIST_IDS=
INITIAL_BLACKLIST_IDS=
INITIAL_GROUP_WHITELIST_IDS=

# --- 4. OpenList 集成配置 (留空 OPENLIST_BASE_URL 时自动禁用分享与媒体直发) ---
OPENLIST_BASE_URL=
OPENLIST_PUBLIC_URL=
OPENLIST_TOKEN=
OPENLIST_USERNAME=
OPENLIST_PASSWORD=
OPENLIST_BAIDU_PATH=/baidu/转存文件
OPENLIST_PIKPAK_PATH=/pikpak/转存文件
OPENLIST_QUARK_PATH=/quark/转存文件
OPENLIST_SHARE_TTL_HOURS=24

# --- 5. 网盘初始配置与保存路径 (必须为非 / 的规范化绝对路径) ---
BAIDU_CLIENT_ID=
BAIDU_CLIENT_SECRET=
BAIDU_SAVE_PATH=/转存文件

PIKPAK_SAVE_PATH=/My Pack/转存文件
PIKPAK_PAT=
PIKPAK_DIRECT_EXCLUSIVE_DIR=false

QUARK_SAVE_PATH=/转存文件
QUARK_COOKIE=

# --- 6. 资源与历史保留参数 ---
MAX_DELIVERY_FILES=10
MAX_TEMP_DISK_MB=2560
PENDING_INPUT_TTL_SECONDS=600
MAX_RETAINED_TASKS=1000
LOG_LEVEL=INFO
